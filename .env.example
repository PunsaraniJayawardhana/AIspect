JIRA_BASE_URL=https://yourname.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Optional: only used as a fallback for project-browsing endpoints when no
# project_key query param is given. The pipeline itself works with any
# story key from any project on this Jira Cloud site (e.g. EXC-1, PROJ-42).
JIRA_PROJECT_KEY=EXC

ANTHROPIC_API_KEY=

MODULE1_MODEL=claude-sonnet-4-6
MODULE2_MODEL=claude-sonnet-4-6
MODULE3_MODEL=claude-sonnet-4-6

MODULE2_PASSES=5
CI_HIGH_THRESHOLD=0.80
CI_MEDIUM_THRESHOLD=0.60

FRONTEND_ORIGIN=http://localhost:5173